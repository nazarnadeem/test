rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Gym logos (publicly readable, writeable)
    match /gym_logos/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Gym member photos (publicly readable, writeable)
    match /tenants/{tenantId}/members/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Gym team member photos (publicly readable, writeable)
    match /tenants/{tenantId}/team_members/{allPaths=**} {
      allow read, write: if true;
    }
    
    // Gym facility showcase media (photos & videos)
    match /tenants/{tenantId}/gallery/{allPaths=**} {
      allow read, write: if true;
    }
    
    // User profile photos (publicly readable, writeable)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if true;
    }

    // Default global rule for all other assets
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
